<?xml version="1.0" encoding="utf-8"?>
<!-- Actualizador no usa paquetes NuGet: todo sale de la biblioteca estándar de .NET y de Windows. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
