<Project>
  <!-- Opciones comunes de todos los proyectos de Actualizador. -->
  <PropertyGroup>
    <Version>2.0.45</Version>
    <Company>Actualizador</Company>
    <Product>Actualizador</Product>
    <Copyright>Actualizador</Copyright>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <Features>strict</Features>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- CA1416: el código es sólo para Windows (lo declara SupportedOSPlatform); SYSLIB0014: WebRequest se usa a propósito (proxy del sistema y plazos por pedido). -->
    <NoWarn>$(NoWarn);CA1416;SYSLIB0014;CS1591;CS0649</NoWarn>
    <SatelliteResourceLanguages>es</SatelliteResourceLanguages>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <!--
    Fuera de Windows (integración continua en Linux) se agrega net48 compilado contra los ensamblados de referencia de Mono:
    así la interfaz WinForms también se compila y se prueba sin Windows. La versión que se entrega es net8.0-windows.
  -->
  <PropertyGroup Condition="'$(OS)' != 'Windows_NT'">
    <SpVerify>true</SpVerify>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == 'net48' and '$(OS)' != 'Windows_NT'">
    <FrameworkPathOverride>/usr/lib/mono/4.8-api</FrameworkPathOverride>
    <AutomaticallyUseReferenceAssemblyPackages>false</AutomaticallyUseReferenceAssemblyPackages>
  </PropertyGroup>
</Project>
