<Project Sdk="Microsoft.NET.Sdk">
  <!-- Actualizador.Aviso.exe: lo ejecuta la revisión programada. Busca sin instalar nada y avisa junto al reloj. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFrameworks>net8.0-windows</TargetFrameworks>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>Actualizador.Aviso</AssemblyName>
    <RootNamespace>Actualizador.Aviso</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>
  <PropertyGroup Condition="'$(SpVerify)' == 'true'">
    <TargetFrameworks>net48</TargetFrameworks>
    <UseWindowsForms>false</UseWindowsForms>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Actualizador.Core\Actualizador.Core.csproj" />
    <ProjectReference Include="..\Actualizador.Engine\Actualizador.Engine.csproj" />
  </ItemGroup>
</Project>
