<Project Sdk="Microsoft.NET.Sdk">
  <!-- Núcleo: modelos, utilidades de Windows (procesos, registro, firmas, WMI por COM) y seguridad (política y registro de auditoría). -->
  <PropertyGroup>
    <TargetFrameworks>net8.0-windows</TargetFrameworks>
    <TargetFrameworks Condition="'$(SpVerify)' == 'true'">net8.0;net48</TargetFrameworks>
    <RootNamespace>Actualizador.Core</RootNamespace>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="System.Net.Http" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Actualizador.Tests" />
  </ItemGroup>
</Project>
